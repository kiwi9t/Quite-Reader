{
  "name": "vocab-reader-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:generate": "prisma generate",
    "db:init": "tsx src/persistence/initDb.ts",
    "db:push": "prisma generate && tsx src/persistence/initDb.ts",
    "server": "tsx src/server.ts",
    "start": "npm run db:init && npm run server",
    "build": "esbuild src/server.ts src/persistence/initDb.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outdir=dist --out-extension:.js=.cjs",
    "start:prod": "node dist/persistence/initDb.cjs && node dist/server.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "epub2": "^3.0.2",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  }
}
