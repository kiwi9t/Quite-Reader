# Backend service, e.g. Render (see render.yaml)
LLM_PROVIDER=openai
# Supabase → Connect → Session pooler (IPv4, port 5432)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3000
# Comma-separated; * wildcard allowed for Vercel preview URLs
ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app,https://your-project-*.vercel.app

MAX_JSON_BODY_BYTES=256000
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
LLM_TIMEOUT_MS=45000
LLM_MAX_PROMPT_CHARS=90000
LLM_STRUCTURED_MAX_ATTEMPTS=3

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Optional providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Frontend service, e.g. Vercel
VITE_API_BASE_URL=https://your-service.onrender.com
