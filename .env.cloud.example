# Backend service, e.g. Railway
LLM_PROVIDER=openai
DATABASE_URL="file:/data/quiet-reader.db"
# Or store data in Supabase Postgres (session pooler string; see README):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PORT=3000
ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app

MAX_JSON_BODY_BYTES=256000
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
LLM_TIMEOUT_MS=45000
LLM_MAX_PROMPT_CHARS=90000
LLM_STRUCTURED_MAX_ATTEMPTS=3

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# Optional providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Readers can enter their own DeepSeek key in the app. Leave DEEPSEEK_API_KEY
# unset on a public deployment so nobody spends your balance; set it only if
# you want a server-side fallback for readers who have no key.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Frontend service, e.g. Vercel
VITE_API_BASE_URL=https://your-backend-domain.up.railway.app
